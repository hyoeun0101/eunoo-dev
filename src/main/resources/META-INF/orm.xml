<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm
                                     https://jakarta.ee/xml/ns/persistence/orm/orm_3_2.xsd"
                 version="3.2">

    <mapped-superclass class="eunoospring.splearn.domain.AbstractEntity" access="FIELD">
        <attributes>
            <id name="id">
                <generated-value strategy="IDENTITY"/>
            </id>
        </attributes>
    </mapped-superclass>

    <entity class="eunoospring.splearn.domain.member.Member" access="FIELD">
        <table name="MEMBER">
            <unique-constraint name="UK_MEMBER_EMAIL_ADDRESS">
                <column-name>email_address</column-name>
            </unique-constraint>
        </table>

        <attributes>
            <basic name="nickname">
                <column length="100" nullable="false"/>
            </basic>

            <basic name="passwordHash">
                <column length="200" nullable="false"/>
            </basic>

            <basic name="status">
                <column length="50" nullable="false"/>
                <enumerated>STRING</enumerated>
            </basic>

            <embedded name="email">
                <attribute-override name="address">
                    <column name="email_address" length="150" nullable="false"/>
                </attribute-override>
            </embedded>
        </attributes>
    </entity>

    <entity class="eunoospring.splearn.domain.member.MemberDetail" access="FIELD"/>

</entity-mappings>
